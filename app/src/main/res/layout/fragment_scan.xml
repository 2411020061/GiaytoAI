<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".ui.scan.ScanFragment">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnCloseScan"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:cardBackgroundColor="#80000000"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="✕"
                android:textColor="@color/white"
                android:textSize="18sp" />
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Nút Lật / Đổi Camera -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnSwitchCamera"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:cardBackgroundColor="#80000000"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="@color/white" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Nút Xoay Preview Camera 90 độ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnRotatePreview"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            app:cardBackgroundColor="#80000000"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_rotate"
                app:tint="@color/white" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Center Viewfinder Guideline Frame (CCCD Standard Ratio 85.6 x 54mm) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/scanFrame"
            android:layout_width="320dp"
            android:layout_height="205dp"
            android:layout_centerInParent="true"
            app:cardBackgroundColor="#08FFFFFF"
            app:cardCornerRadius="14dp"
            app:strokeColor="#00E676"
            app:strokeWidth="2dp">

            <LinearLayout
                android:id="@+id/layoutCenterCapture"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="#00E676" />

                <TextView
                    android:id="@+id/tvScanStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text=""
                    android:textColor="#00E676"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Scanning Guideline Tips -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/scanFrame"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:text="☀️ Đủ sáng   📐 Cân đối khung hình   ⚡ Tự động quét QR"
            android:textColor="#CED4DA"
            android:textSize="11sp"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- Bottom Camera Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Gallery Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnGallery"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardBackgroundColor="#40FFFFFF"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:tint="@color/white" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Shutter Capture Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnCapture"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="36dp"
                app:strokeColor="#ADB5BD"
                app:strokeWidth="4dp">

                <View
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/badge_rounded_active" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Gallery Pick & Computer Upload Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChooseFromGallery"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#40FFFFFF"
                android:text="🖼️ Thư viện"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUploadCccd"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="#2196F3"
                android:text="💻 Chọn từ máy tính"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
